BT 1 0 0 1 4 83.2 Tm /F4 7 Tf 8.2 TL (#!/usr/bin/env bash) Tj T* (# scanlib.sh - reusable scan-data library. Usage: source scanlib.sh) Tj T* (export LC_ALL=C) Tj T* (SCOPE_DEFAULT=${SCOPE_DEFAULT:-192.168.56}) Tj T* (LOOKUP=${LOOKUP:-svc_lookup.csv}) Tj T* (err\(\){ echo "scanlib: $*" >&2; }) Tj T* (valid_ip\(\){ [[ $1 =~ ) Tj T* (  ^\(\(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]\)\\.\){3}\(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]\)$ ]]; }) Tj T* (valid_port\(\){ [[ $1 =~ ^[0-9]+$ ]] && \(\( 10#$1>=1 && 10#$1<=65535 \)\); }) Tj T* (check_schema\(\){ # file expected_header -> 0 ok, 2 missing file, 3 header mismatch) Tj T* (  local f=${1:?file} h=${2:?header}) Tj T* ET
Q
 

