BT 1 0 0 1 4 34 Tm /F4 7 Tf 8.2 TL (E1 Which hosts have telnet open?              awk -F, '$2==23&&$4=="open"{print $1}' ports.csv) Tj T* (E2 How many open ports does each host have?     awk ... c[$1]++ ... ports.csv | sort) Tj T* (E3 Open ports lacking a service record?         join -t, -v1 <\(keyed ports.csv\) <\(keyed services.csv\)) Tj T* (E4 Hosts lacking an OS row?                     join -t, -v1 hosts_ips os_ips) Tj T* (E5 Duplicate host-port-proto keys?              cut -d, -f1-3 ports.csv | sort | uniq -d) Tj T* ET
