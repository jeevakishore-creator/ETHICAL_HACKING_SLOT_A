1 0 0 1 0 0 cm  BT /F1 12 Tf 14.4 TL ET
BT /F2 9 Tf 10.8 TL ET
BT 1 0 0 1 142.3995 28 Tm (Rithik Roshan S  |  REG NO: 192321092  |  ITA1439 CO3 - Assignment_3  |  Page 15) Tj T* ET
q
1 0 0 1 77.5 307.8898 cm
%PreformattedPara
0 0 0 rg
BT 1 0 0 1 4 485 Tm /F4 7 Tf 8.2 TL (  [[ -r $f ]] || { err "missing file: $f"; return 2; }) Tj T* (  [[ $\(head -1 "$f" | tr -d '\\r'\) == "$h" ]] || { err "header mismatch in $f"; return 3; }; }) Tj T* (clean_ports\(\){ # in [out] [rejected] [scope-prefix]  \(ip,port,proto,state\)) Tj T* (  local in=${1:?in} out=${2:-ports_clean.csv} rej=${3:-ports_rejected.csv} sc=${4:-$SCOPE_DEFAULT}) Tj T* (  check_schema "$in" "ip,port,proto,state" || return $?) Tj T* (  head -1 "$in" > "$out"; echo "reason,$\(head -1 "$in"\)" > "$rej") Tj T* (  awk -F, -v S="$sc" -v O="$out" -v R="$rej" 'NR>1{ r=""; n=split\($1,a,"."\)) Tj T* (    if\($1==""||$2==""||$3==""||$4==""\) r="MISSING_VALUE") Tj T* (    else if\($1!~/^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$/||a[1]>255||a[2]>255||a[3]>255||a[4]>255\) r="BAD_IP") Tj T* (    else if\(index\($1,S"."\)!=1\) r="OUT_OF_SCOPE") Tj T* (    else if\(a[4]==0||a[4]==255\) r="REVIEW_NETWORK_OR_BROADCAST") Tj T* (    else if\($2!~/^[0-9]+$/||$2<1||$2>65535\) r="BAD_PORT") Tj T* (    else if\(\($1 SUBSEP $2 SUBSEP $3\) in seen\) r="DUPLICATE") Tj T* (    if\(r==""\){seen[$1,$2,$3]=1; print $0 >> O} else print r","$0 >> R }' "$in"; }) Tj T* (std_service\(\){ # in [out] [review] [lookup]  \(service = column 4\)) Tj T* (  local in=${1:?in} out=${2:-svc_std.csv} rev=${3:-svc_review.csv} lk=${4:-$LOOKUP}) Tj T* (  [[ -r $in && -r $lk ]] || { err "missing input or lookup"; return 2; }) Tj T* (  awk -F, -v O="$out" -v V="$rev" 'BEGIN{OFS=","} FNR==NR{m[tolower\($1\)]=$2;next}) Tj T* (    FNR==1{print > O; print "reason,"$0 > V; next}) Tj T* (    {k=tolower\($4\); if\(k==""\) print "MISSING_SERVICE,"$0 > V) Tj T* (     else if\(k in m\){$4=m[k]; print > O} else print "UNKNOWN_SERVICE,"$0 > V}' "$lk" "$in"; }) Tj T* (wide2long\(\){ # wide.csv \(ip,<port>...\) -> ip,port,state) Tj T* (  [[ -r ${1:-} ]] || { err "missing file"; return 2; }) Tj T* (  awk -F, 'NR==1{for\(i=2;i<=NF;i++\)h[i]=$i; print "ip,port,state"; next}) Tj T* (    {for\(i=2;i<=NF;i++\) print $1","h[i]","$i}' "$1"; }) Tj T* (long2wide\(\){ # long.csv -> wide \(round trip\)) Tj T* (  awk -F, 'NR>1{ if\(!\($1 in s\)\){s[$1]=1;ips[++n]=$1} if\(!\($2 in p\)\){p[$2]=1;ports[++m]=$2} v[$1,$2]=$3 }) Tj T* (    END{printf "ip"; for\(j=1;j<=m;j++\)printf ",%s",ports[j]; print "") Tj T* (        for\(i=1;i<=n;i++\){printf "%s",ips[i]; for\(j=1;j<=m;j++\)printf ",%s",v[ips[i],ports[j]]; print ) Tj T* (          ""}}' "${1:?}"; }) Tj T* (cast_open\(\){ awk -F, 'NR>1&&$3=="open"{c[$1]++} END{for\(h in c\)print h","c[h]}' "${1:?}" | sort; }) Tj T* (cast_matrix\(\){ # ports_clean + svc_std -> host x service counts) Tj T* (  awk -F, 'NR>1{c[$1,$4]++; h[$1]; s[$4]} END{printf "ip"; for\(x in s\)printf ",%s",x; print "") Tj T* (    for\(i in h\){printf "%s",i; for\(x in s\)printf ",%d",c[i,x]; print ""}}' "${1:?}" | { read -r hd; echo) Tj T* (       "$hd"; sort; }; }) Tj T* (keyed\(\){ awk -F, 'NR>1{printf "%s:%s:%s",$1,$2,$3; for\(i=4;i<=NF;i++\)printf ",%s",$i; print ""}' ) Tj T* (  "${1:?}" | sort -t, -k1,1; }) Tj T* (merge_ps\(\){ # ports svc mode\(inner|left|full\)) Tj T* (  local mode=${3:-left} o=\(\)) Tj T* (  case $mode in inner\) ;; left\) o=\(-a1\);; full\) o=\(-a1 -a2\);; *\) err "bad mode"; return 2;; esac) Tj T* (  join -t, "${o[@]}" -e NA -o auto <\(keyed "${1:?}"\) <\(keyed "${2:?}"\); }) Tj T* (export_versioned\(\){ # file prefix [dir]) Tj T* (  local f=${1:?file} pre=${2:?prefix} d=${3:-out} ts=${RUN_TS:-$\(date +%Y%m%d-%H%M%S\)} n=1 dest) Tj T* (  [[ -r $f ]] || { err "missing file: $f"; return 2; }) Tj T* (  mkdir -p "$d") Tj T* (  while :; do dest="$d/${pre}_${ts}_v${n}.csv") Tj T* (    \( set -o noclobber; cat "$f" > "$dest" \) 2>/dev/null && break; \(\(n++\)\); done) Tj T* (  \( cd "$d" && sha256sum "$\(basename "$dest"\)" >> SHA256SUMS \); echo "$dest"; }) Tj T* (readback\(\){ # written-file original -> 0 if identical) Tj T* (  cmp -s "$1" "$2" && [[ $\(wc -l <"$1"\) -eq $\(wc -l <"$2"\) ]] || { err "read-back mismatch: $1"; return ) Tj T* (    1; }; }) Tj T* (scan_pipeline\(\){ # ports.csv svc.csv [scope] [outdir]) Tj T* (  \( set -euo pipefail; trap 'err "pipeline failed at line $LINENO"' ERR) Tj T* (    local p=${1:?ports} s=${2:?services} sc=${3:-$SCOPE_DEFAULT} d=${4:-out}; mkdir -p "$d") Tj T* (    clean_ports "$p" "$d/ports_clean.csv" "$d/ports_rejected.csv" "$sc") Tj T* (    std_service "$s" "$d/svc_std.csv" "$d/svc_review.csv") Tj T* (    merge_ps "$d/ports_clean.csv" "$d/svc_std.csv" left | awk -F, ) Tj T* (      'BEGIN{OFS=","}{split\($1,k,":"\);$1=k[1]","k[2]","k[3];print}' | sort > "$d/master_ports.csv") Tj T* (    echo "in=$\(\($\(wc -l <"$p"\)-1\)\) clean=$\(\($\(wc -l <"$d/ports_clean.csv"\)-1\)\) rejected=$\(\($\(wc -l ) Tj T* (      <"$d/ports_rejected.csv"\)-1\)\) master=$\(wc -l <"$d/master_ports.csv"\)"; \); }) Tj T* ET
